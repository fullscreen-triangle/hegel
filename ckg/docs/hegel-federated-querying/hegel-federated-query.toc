\contentsline {paragraph}{Honesty is assumed, never verified.}{29}{section*.2}%
\contentsline {paragraph}{Yields are posited, not estimated.}{29}{section*.3}%
\contentsline {paragraph}{No regret bound for replanning.}{29}{section*.4}%
\contentsline {paragraph}{Retention laws are unmeasured.}{29}{section*.5}%
\contentsline {paragraph}{Namespace disjointness is a modelling decision.}{29}{section*.6}%
\contentsline {paragraph}{Wall-clock time is not modelled.}{29}{section*.7}%
\contentsline {paragraph}{The static check is not a completeness result.}{30}{section*.8}%
